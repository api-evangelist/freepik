{
  "opencollection": "1.0.0",
  "info": {
    "name": "Freepik / Magnific Audio Tasks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-magnific-api-key",
      "value": "{{x-magnific-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Poll task status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.magnific.com/v1/ai/:endpoint/:taskId",
            "params": [
              {
                "name": "endpoint",
                "value": "",
                "type": "path"
              },
              {
                "name": "taskId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Poll task status"
        }
      ]
    }
  ],
  "bundled": true
}